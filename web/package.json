{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "typecheck:eval": "tsc --project tsconfig.eval.json",
    "test:unit": "node --import tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "eval:user-vector:fixture": "tsx bench/user-vector-eval.ts",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "graphology": "^0.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
